# Audit uses only the Python standard library; no key or .env loading is required.
DATA_DIR=./data/raw
EXTERNAL_DIR=./data/external
# GMS generation settings. Use the endpoint and model from your GMS account.
GMS_API_KEY=
GMS_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1
CHAT_MODEL=gpt-6-astra
# Enable only after source transmission is authorized. Keep raw data/CoT out of requests.
GMS_ALLOW_SOURCE_TRANSMISSION=false
GMS_TIMEOUT_SECONDS=90
GMS_MAX_OUTPUT_TOKENS=2500
# Optional direct OpenAI key. Local indexing never uses any API key.
OPENAI_API_KEY=
EMBEDDING_PROVIDER=fastembed_local
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CHROMA_DIR=./storage/chroma
MODEL_CACHE_DIR=./storage/models
EMBEDDING_CACHE_FILE=./storage/embedding_cache.sqlite3
EMBEDDING_THREADS=1
EMBEDDING_WORKERS=8
INDEX_BATCH_SIZE=128
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
DOCUMENT_TOP_K=10
DOCUMENT_FETCH_K=30
SEARCH_MODE=mmr
# 1 = relevance only, 0 = more diversity (first hit is still most relevant).
MMR_LAMBDA_MULT=0.5
